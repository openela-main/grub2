 grub-core/Makefile.core.def               |   2 +
 grub-core/tests/appended_signature_test.c | 368 +++++++++-------
 grub-core/tests/appended_signatures.h     | 709 ++++++++++++++++++++++--------
 3 files changed, 730 insertions(+), 349 deletions(-)

diff --git a/grub-core/Makefile.core.def b/grub-core/Makefile.core.def
