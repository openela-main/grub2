-	  goto cleanup_buf;
-	}
-      total_read_size += read_size;
-    }
-
-  err = certificate_import (buf, total_read_size, certificate);
+  err = file_read_all (f, &buf, &file_size);
   if (err != GRUB_ERR_NONE)
-    goto cleanup_buf;
+    return err;
 
-  return GRUB_ERR_NONE;
